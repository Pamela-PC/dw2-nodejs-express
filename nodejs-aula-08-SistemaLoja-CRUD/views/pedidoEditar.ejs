<%- include('partials/header.ejs')%>
<%- include('partials/navbar.ejs')%>

<div class="container">
    <div class="card-header">
        <h1>Editar Pedidos</h1>
    </div>

    <div class="card-body">
         <label for="numero">Número do pedido: </label>
                    <input type="text" name="numero" id="numero" class="form-control" placeholder="Insira o número do pedido" required>
                    <label for="valor">Valor do pedido: </label>
                    <input type="text" name="valor" id="valor" class="form-control" placeholder="Insira o valor" required>
                    <br>
                    <button type="submit" class="btn btn-success">Cadastrar</button>
                    <button type="reset" class="btn btn-danger">Limpar</button>
                    <input type="hidden" name="id" id="id" value="<%=pedido.id %>">
                    <br>
                    <button type="submit" class="btn btn-warning" onclick="return confirm('Deseja mesmo alterar o pedido <%=pedido.nome %>')">Alterar</button>
                    <a href="/pedidos">
                    <button type="button" class="btn btn-danger">Cancelar</button>
                    </a>
    </div>
</div>

<%- include('partials/footer.ejs')%>