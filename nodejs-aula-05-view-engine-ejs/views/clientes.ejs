<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>clientes</title>
</head>
<body>
    <a href="/"> << Voltar</a>
    <br>
    <h1 style="text-align: center;">Página Clientes</h1>

    <table border="1">

        <tr>
           <th width="150px">Clientes</th>
           <th>CPF</th>
        </tr>

        <% clientes.forEach(cliente => {%>
            <tr>
                <th><%= cliente.nome%></th>
                <th><%= cliente.cpf%></th>
            </tr>
        <%})%>
    </table>
  
</body>
</html>