<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

        <!-- Formulário de cadastro de Pedido -->
        <div class="container">
            <div class="card">
                <div class="card-header">
                    <h1>Registrar pedido</h1>
                </div>
                <div class="card-body">
                    <form method="POST" action="/pedidos/cadastrar">
                        <label>Número do pedido:</label>
                        <input type="text" name="numero" id="numero" placeholder="Insira o número do pedido"
                            class="form-control" required>

                        <label>Valor do pedido:</label>
                        <input type="text" name="valor" id="valor" placeholder="Insira o valor do pedido"
                            class="form-control" required>

                        <label>Cliente:</label>
                        <select name="clienteId" id="clienteId" class="form-control" required>
                            <option value="" selected disabled>Selecione um cliente</option>
                            <% clientes.forEach(cliente=> { %>
                                <option value="<%= cliente.id %>">
                                    <%= cliente.nome %>
                                </option>
                                <% }) %>
                        </select>
                        <br>
                        <button class="btn btn-success">Cadastrar</button>
                    </form>
                    <hr>
                </div>
            </div>
        </div>
        <br>

    <div class="container">
        <div class="card">
            <div class="card-header">
                <h1>Pedidos</h1>
            </div>
            <div class="card-body">
                <table>
                    <thead>
                        <tr>
                            <th></th>
                            <th>Número:</th>
                            <th>Valor:</th>
                            <th>Nome do Cliente</th>
                            <th>CPF do Cliente</th>
                            <th style="text-align: center;" colspan="2">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% pedidos.forEach(pedido => { %>
                        <tr>
                            <td><img src="imgs/order.png" width="30px"></td>
                            <td><%= pedido.numero %></td>
                            <td><%= pedido.valor.toLocaleString('pt-br', {style: 'currency', currency: 'BRL'}) %></td>
                            <!-- Nome do cliente -->
                            <td><%= pedido.cliente.nome%></td>  
                            <!-- CPF do Cliente -->
                             <td><%= pedido.cliente.cpf%></td>
                            <td>
                                <a class="btn btn-warning" href="/pedidos/editar/<%= pedido.id %>">Editar</a>
                            </td>

                            <td>
                                <a class="btn btn-danger" href="/pedidos/excluir/<%= pedido.id %>" onclick="return confirm('Deseja excluir o pedido <%= pedido.numero %>')">Excluir</a>
                            </td>

                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<%- include ('partials/footer.ejs') %>
