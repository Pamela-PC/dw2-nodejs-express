<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar') %>

<div class="container">
    <div class="card-header">
        <h1>Editar pedidos</h1>
        <hr>
    </div>
    <div class="card-body">
        <form action="/pedidos/alterar" method="POST">
            <label for="numero">Numero do Pedido</label>
            <input type="text" name="numero" id="numero" class="form-control" required value="<%= pedido.numero %>">
            <label for="valor">Valor do Pedido</label>
            <input type="text" name="valor" id="valor" class="form-control" required value="<%= pedido.valor %>">
            <!-- Campo invisivel com a ID do cliente  -->
             <input type="hidden" name="id" id="id" value="<%= pedido.id %>">
            <br>
            <button type="submit" class="btn btn-warning" onclick="return confirm('Deseja mesmo alterar o pedido <%= pedido.numero %>')">Alterar</button>
            <a href="/clientes">
                <button type="button" class="btn btn-danger">Cancelar</button>
            </a>
        </form>
    </div>
</div>

<%- include ('partials/footer.ejs') %>